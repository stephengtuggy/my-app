{
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    },
    "preserveWhitespaces": "off",
    "strictTemplates": true
  },
  "compileOnSave": false,
  "compilerOptions": {
    "importHelpers": true,
    "outDir": "../out-tsc/spec",
    "types": [
      "node",
      "@vitest/globals"
    ],
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "target": "ES2022",
    "typeRoots": [
      "../node_modules/@types"
    ],
    "module": "ES2022"
  },
  "files": [
    "polyfills.ts"
  ],
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ]
}
